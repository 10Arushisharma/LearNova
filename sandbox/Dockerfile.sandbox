FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install minimal scientific packages for ML/Data Science learning exercises
RUN pip install --no-cache-dir numpy==2.1.3 pandas==2.2.3 scikit-learn==1.5.2

# Non-privileged sandbox user
RUN useradd --create-home --shell /usr/sbin/nologin --uid 10001 sandboxuser

WORKDIR /workspace
COPY runner.py /opt/runner.py
RUN chmod 555 /opt/runner.py

USER sandboxuser
ENTRYPOINT ["python", "-I", "/opt/runner.py"]
