# ==========================================
# LEARNOVA ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=Learnova
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-64-char-secret-in-production
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (PostgreSQL primary; SQLite supported for local standalone tests)
DATABASE_URL=sqlite:///./learnova_dev.db
# Example local SQLite override for quick offline dev without Postgres:
# DATABASE_URL=sqlite:///./learnova_dev.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# AI Provider (OpenAI-compatible)
# Leave AI_API_KEY empty to use transparent local Socratic development fallback
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.4

# Isolated Python Sandbox
# Use "docker" in production/Docker Compose, or "subprocess" for local dev without Docker daemon
SANDBOX_MODE=subprocess
SANDBOX_IMAGE=learnova-python-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=0.5

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MENTOR_RATE_LIMIT_PER_MINUTE=20
SANDBOX_RATE_LIMIT_PER_MINUTE=30
